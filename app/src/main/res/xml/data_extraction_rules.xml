<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- PRD 1.3: Exclude security prefs to prevent Keystore mismatch crashes on restore -->
        <exclude domain="sharedpref" path="meditime_secure_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="meditime_secure_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>